# Copy to .env and fill in API keys (never commit .env).
#
# --- Docker Compose (UI in container) ---
# PSYMAS_BACKEND_URL is set automatically to http://backend:8000 in docker-compose.yml.
#
# --- Host Streamlit + Docker backend only ---
# Windows: use 9000 (port 8000 is often reserved by the OS — see docker-compose.yml)
# PSYMAS_BACKEND_URL=http://localhost:9000

OPENROUTER_API_KEY=

# Optional managed/public deployment profile. In Railway, set these as service
# variables and keep OPENROUTER_API_KEY in the platform's secret store.
# PSYMAS_DEPLOYMENT_PROFILE=railway
# PSYMAS_LOCK_LLM=1
# PSYMAS_LLM_PROVIDER=openrouter
# PSYMAS_OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash-0731

# Optional local Ollama endpoint. Use the host address below when the UI runs
# in Docker Desktop on Windows or macOS.
# OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
# Optional local-generation controls. Larger num_ctx uses more RAM/VRAM.
# PSYMAS_OLLAMA_NUM_CTX=8192
# PSYMAS_OLLAMA_TEMPERATURE=0.2
# PSYMAS_OLLAMA_TOP_P=0.9
# PSYMAS_OLLAMA_NUM_PREDICT=512

# Optional: enable Redis profile for multi-worker backend
# docker compose --profile redis up --build
# REDIS_URL=redis://redis:6379/0
# PSYMAS_GUNICORN_WORKERS=4
