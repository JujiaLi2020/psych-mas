# Railway deployment profile. Copy these variables into both the UI and backend services.
PSYMAS_DEPLOYMENT_PROFILE=railway
PSYMAS_LOCK_LLM=1
PSYMAS_LLM_PROVIDER=openrouter
PSYMAS_OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash-0731

# Set this as a Railway Secret, not in Git or in the Docker image.
OPENROUTER_API_KEY=

# UI service only: use the backend service's private Railway URL when available.
# PSYMAS_BACKEND_URL=http://<backend-service>.railway.internal:8000
